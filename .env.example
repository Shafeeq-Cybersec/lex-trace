PORT=3001
HOST=127.0.0.1
TRACE_DATA_DIR=.trace-v2
# One server-side Gemini credential. Rate limits pause work; TRACE does not rotate keys to bypass quotas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
TRACE_PUBLIC_ORIGIN=http://127.0.0.1:5173
# Optional locally; production should set a stable random secret of >=32 characters.
TRACE_SESSION_SECRET=
# NODE_ENV=production requires HTTPS. Run one instance with persistent disk.
